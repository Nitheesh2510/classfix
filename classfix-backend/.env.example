# Copy to .env and adjust. Everything here has a working default except in production.

NODE_ENV=development
PORT=4000

# Required when NODE_ENV=production. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Where the SQLite file and uploaded images live.
DATABASE_FILE=./data/classfix.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=2097152

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Password given to every seeded demo account.
SEED_PASSWORD=classfix123
